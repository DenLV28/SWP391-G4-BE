# Backend API URL
# For local development: http://localhost:4000
# For production: https://api.parkflow.com
VITE_API_URL=http://localhost:4000

# PaddleOCR license-plate service (see ocr-service/README.md)
# Để TRỐNG là đúng cho hầu hết trường hợp: frontend gọi '/ocr/...' rồi Vite proxy
# sang cổng 8868, nên chạy được cả khi mở app qua ngrok (HTTPS) hoặc từ máy khác
# trong LAN. Chỉ điền khi dịch vụ OCR nằm trên một host riêng.
VITE_OCR_API_URL=

# Optional fallback OCR engine when the PaddleOCR service is down
VITE_GEMINI_API_KEY=
