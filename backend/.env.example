# Sao chép file này thành backend/.env rồi điền giá trị thật.
# backend/.env KHÔNG được commit (đã nằm trong .gitignore).

# ── VNPay ────────────────────────────────────────────────────────────────────
# Đăng ký tài khoản sandbox tại https://sandbox.vnpayment.vn/devreg/
# Bỏ trống thì các API thanh toán VNPay sẽ ký sai chữ ký và bị cổng từ chối.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/vnpay/return
FRONTEND_URL=http://localhost:5173

# ── SQL Server ───────────────────────────────────────────────────────────────
# Bỏ trống thì dùng mặc định cho máy dev (sa / 12345 / localhost).
DB_SERVER=localhost
DB_NAME=parking_management
DB_USER=sa
DB_PASSWORD=

# ── Máy chủ ──────────────────────────────────────────────────────────────────
PORT=4000
